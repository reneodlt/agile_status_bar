<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en_GB</string>
	<key>CFBundleExecutable</key>
	<string>OctoStatusBar</string>
	<key>CFBundleIdentifier</key>
	<string>io.reneo.OctoStatusBar</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Agile Bar</string>
	<key>CFBundleDisplayName</key>
	<string>Agile Bar</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- These two are the single source of truth for the app's version, because
	     ./build.sh copies this file verbatim and does no variable substitution.
	     Setting MARKETING_VERSION / CURRENT_PROJECT_VERSION as build settings
	     instead looks like it works and does nothing: the values only reach the
	     bundle if this file interpolates them. Bump CFBundleVersion for every
	     upload — App Store Connect refuses a duplicate build number. -->
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleVersion</key>
	<string>3</string>
	<!-- CFBundleIconFile is the legacy .icns lookup, still used by ./build.sh.
	     CFBundleIconName points at the AppIcon set inside Assets.car and is
	     what App Store validation actually requires; without it an upload is
	     rejected for a missing 512pt@2x icon however complete the .icns is. -->
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<!-- The app only makes standard HTTPS requests, which are exempt from
	     export regulations. Declaring it here stops App Store Connect asking
	     the export-compliance question on every single upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Menu bar accessory: no Dock icon, no main window. -->
	<key>LSUIElement</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Rich Green. Released under the MIT Licence.</string>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>NSSupportsSuddenTermination</key>
	<false/>
</dict>
</plist>
